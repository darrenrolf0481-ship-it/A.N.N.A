@charset "utf-8";

.try-chat-case[data-v-9d46c3ec] { flex-direction: column; height: 100%; display: flex; }

.case-chat[data-v-9d46c3ec] { flex-direction: column; flex: 1 1 0%; align-items: center; height: 100%; display: flex; position: relative; overflow: auto; }

.case-chat-list[data-v-9d46c3ec] { box-sizing: border-box; flex-direction: column; gap: 30px; width: 100%; max-width: 780px; margin: 0px auto; padding: 16px 16px 30px; display: flex; }

.case-try-container[data-v-9d46c3ec] { box-sizing: border-box; border-bottom: .5px solid var(--Separators-S1); justify-content: space-between; align-items: center; width: 100%; padding: 10px 16px; display: flex; }

.case-try-container .example[data-v-9d46c3ec] { color: var(--Labels-Primary); font-size: 16px; font-weight: 400; line-height: 24px; }

.case-try-container[data-v-9d46c3ec] .kimi-button { background: var(--Fills-F1); height: 28px; color: var(--Labels-Primary); border-radius: 8px; min-width: 0px; padding: 0px 8px; font-size: 14px; font-weight: 500; line-height: 20px; }

.datasource-case-modal { box-sizing: border-box; width: 800px; height: 608px; background: var(--BgGp-Primary) !important; gap: 16px !important; padding: 24px !important; }

@media (max-width: 800px) {
  .datasource-case-modal { width: calc(-80px + 100vw); }
}

@media (max-width: 532px) {
  .datasource-case-mask { align-items: flex-end !important; }
  .datasource-case-mask > div { width: 100%; }
  .datasource-case-modal { width: 100%; border-width: medium !important; border-style: none !important; border-color: currentcolor !important; border-image: none !important; border-radius: 16px 16px 0px 0px !important; padding: 16px !important; }
}

.case-modal-header[data-v-9998fe46] { flex-direction: row; justify-content: space-between; width: 100%; margin-right: 36px; display: flex; }

