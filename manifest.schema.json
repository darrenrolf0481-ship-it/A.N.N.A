{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A.N.N.A. Case Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "name",
    "created_utc",
    "status",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "closed_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "type",
          "original_name",
          "stored_as",
          "sha256",
          "ingested_utc",
          "source"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "video",
              "photo",
              "evp",
              "sensor-log",
              "finding",
              "note"
            ]
          },
          "original_name": {
            "type": "string"
          },
          "stored_as": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer"
          },
          "ingested_utc": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "description": "Short label carried from the finding or note that produced this artifact."
          },
          "attestation_of": {
            "type": "string",
            "description": "Set on second-pass attestations: artifact_id of the finding under review."
          },
          "verdict": {
            "type": "string",
            "enum": [
              "agrees",
              "disagrees",
              "uncertain"
            ],
            "description": "Set on second-pass attestations only."
          },
          "analyst": {
            "type": "string",
            "description": "Set on second-pass attestations only: the reviewer named in the attestation."
          }
        }
      }
    }
  }
}